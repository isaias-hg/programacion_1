@{
    string Act(string s) => (ViewData["Seccion"] as string) == s ? "activo" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Página Web Oficial</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body id="principio" class="sec-@(ViewData["Seccion"] ?? "inicio")">
    <header>
        <nav>
            <a class="marca" asp-page="/Index">Página Web Oficial</a>
            <a class="@Act("calc")" asp-page="/Calculadora">Calculadora</a>
            <a class="@Act("conv")" asp-page="/Conversor">Conversor</a>
            <a class="@Act("quiz")" asp-page="/Quiz">Quiz</a>
            <a class="@Act("hist")" asp-page="/Historial">Historial</a>
            <a class="salir" asp-page="/Salir">Salir</a>
        </nav>
    </header>
    <main>
        @RenderBody()
        @if (ViewData["Regreso"] is true)
        {
            <div class="regreso">
                <a class="btn-sec" href="#principio">↑ Ir al principio de la página</a>
                <a class="btn" asp-page="/Index">⌂ Volver al menú principal</a>
            </div>
        }
    </main>
    <footer>© 2026 Página Web Oficial</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
